# Enable rewrite engine
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Normalize directory trailing slashes
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]

  # Serve existing physical files and directories directly without rewriting
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Prevent rewriting missing XML, TXT, and JSON files to index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} \.(xml|txt|json)$ [NC]
  RewriteRule ^ - [R=404,L]

  RewriteRule ^(api|sanctum)/ backend/public/index.php [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Cache Control Headers
<IfModule mod_headers.c>
  # Cache PWA assets for 1 year (versioned files)
  <FilesMatch "\.(js|css|ico|jpg|jpeg|png|gif|webp)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>

  # Don't cache service worker files
  <FilesMatch "ngsw.*\.js$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
    Header always set X-LiteSpeed-Cache-Control "no-cache, no-store"
  </FilesMatch>

  # Don't cache manifest files
  <FilesMatch "manifest\.webmanifest$">
    Header always set Cache-Control "no-cache"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>

  # Don't cache sitemap and robots files
  <FilesMatch "(sitemap\.xml|robots\.txt)$">
    Header always set Cache-Control "no-cache, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>

  # Cache font files for 1 year
  <FilesMatch "\.(woff2?|ttf|eot|svg)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>

  # Security Headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security \
    "max-age=31536000; includeSubDomains"
  Header always set Permissions-Policy \
    "camera=(), microphone=(), geolocation=()"

  # Strip server information headers
  Header always unset X-Powered-By
  Header always unset Server

  # Content Security Policy (Application baseline for HTML & Service Workers)
  SetEnvIf Request_URI "^/(api|sanctum)(/|$)" API_REQUEST=1
  Header always unset Content-Security-Policy
  Header always set Content-Security-Policy "\
default-src 'self'; \
script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' \
  https://cdn.jsdelivr.net \
  https://static.cloudflareinsights.com; \
style-src 'self' 'unsafe-inline'; \
font-src 'self' data:; \
img-src 'self' data: blob: https://test-flss.alquatrilixbsit2027.com; \
connect-src 'self' \
  https://cdn.jsdelivr.net \
  https://static.cloudflareinsights.com \
  https://cloudflareinsights.com \
  https://test-flss.alquatrilixbsit2027.com \
  https://flss.alquatrilixbsit2027.com; \
frame-src 'self' blob: \
  https://www.youtube-nocookie.com \
  https://www.youtube.com; \
frame-ancestors 'self'; \
form-action 'self'; \
object-src 'self' blob:; \
child-src 'self' blob:; \
worker-src 'self' blob:; \
base-uri 'self';" env=!API_REQUEST
  Header always edit Content-Security-Policy \
    "^upgrade-insecure-requests$" \
    "default-src 'none'; script-src 'none'; style-src 'none'; img-src 'none'; connect-src 'none'; frame-src 'none'; font-src 'none'; media-src 'none'; object-src 'none'; manifest-src 'none'; worker-src 'none'; frame-ancestors 'self'; form-action 'none'; base-uri 'none';"

  # Strict zero-script/zero-style CSP for static XML and text assets
  <FilesMatch "\.(xml|txt)$">
    Header always set Content-Security-Policy \
      "default-src 'none'; base-uri 'none'; form-action 'none';"
  </FilesMatch>

  # Non-blocking Cross-Origin Isolation headers
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set Cross-Origin-Embedder-Policy "unsafe-none"

  # CORS Headers
  SetEnvIf Origin \
    "^https://(test-flss|flss)\.alquatrilixbsit2027\.com$" \
    AccessControlAllowOrigin=$0
  Header always set Access-Control-Allow-Origin \
    "%{AccessControlAllowOrigin}e" env=AccessControlAllowOrigin
  Header always set Access-Control-Allow-Credentials "true"
  Header always set Access-Control-Allow-Methods \
    "GET, POST, PUT, DELETE, OPTIONS"
  Header always set Access-Control-Allow-Headers \
    "Content-Type, Authorization, X-CSRF-TOKEN, X-XSRF-TOKEN"
  Header always set Vary "Origin"

  # Cache-Control Headers for index.html and ngsw.json
  <FilesMatch "index\.html$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
    Header always set X-LiteSpeed-Cache-Control "no-cache, no-store"
  </FilesMatch>

  <FilesMatch "ngsw\.json$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
    Header always set X-LiteSpeed-Cache-Control "no-cache, no-store"
  </FilesMatch>
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/manifest+json
</IfModule>

# Set proper MIME types
<IfModule mod_mime.c>
  AddType application/manifest+json webmanifest
  AddType application/xml xml
  AddType application/javascript js
  AddType application/x-javascript js
  AddType text/css css
  AddType image/svg+xml svg
  AddType image/webp webp
  AddType application/wasm wasm
  AddType application/javascript mjs
  AddType font/woff2 woff2
  AddType font/woff woff
  AddType font/ttf ttf
  AddType font/otf otf
</IfModule>
